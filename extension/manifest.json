{
  "manifest_version": 3,
  "name": "inspeg capture",
  "version": "0.1.0",
  "description": "Right-click capture into your local inspeg knowledge graph: label selections, images, and links in one click; revisit pages with your captures highlighted.",
  "key": "",
  "permissions": ["contextMenus", "storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1:8137/*"],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "anchoring/approx-string-match.js",
        "anchoring/match-quote.js",
        "anchoring/text-range.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "inspeg" }
}
